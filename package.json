{
  "name": "digital-inventory-and-sales-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Digital Inventory and Sales Management System for Karnataka Kirana and Retail Stores",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "vercel-build": "npx prisma generate --schema=server/prisma/schema.prisma && npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run prisma:seed",
    "test": "npm --prefix server run test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.3"
  }
}
